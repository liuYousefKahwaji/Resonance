{
  "manifest_version": 3,
  "name": "Resonance YouTube Connector",
  "version": "1.0.0",
  "description": "Connect your YouTube session to Resonance on this PC.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
